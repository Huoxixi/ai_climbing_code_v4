# Safe local-development defaults. Never commit real keys.
APP_ENV=development
LOCAL_ONLY=true
DISABLE_SUPABASE=true
ENABLE_SIMULATION=true
RELEASE_SHA=development

# Optional pilot login. Quick login is local-only unless remote access is explicitly enabled.
PILOT_AUTH_ENABLED=false
PILOT_QUICK_LOGIN_ENABLED=true
PILOT_QUICK_LOGIN_USERNAME=ma-trial
PILOT_QUICK_LOGIN_DISPLAY_NAME=马老师
PILOT_QUICK_LOGIN_ALLOW_REMOTE=false

# Leave both fields empty to use deterministic local results only.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL_NAME=

# The pilot does not use Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=hold-images
