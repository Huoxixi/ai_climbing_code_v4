{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:browser": "vite --config vite.browser.config.js",
    "build:browser": "vite build --config vite.browser.config.js",
    "preview:browser": "vite preview --config vite.browser.config.js",
    "test:browser-local": "node --test test/browser-local-pose.test.mjs browser-tests/browser-local-replay.test.mjs",
    "test:browser-portal": "node --test browser-tests/browser-portal.test.mjs",
    "test:browser-compiled": "node --test browser-tests/browser-compiled.test.mjs",
    "test:browser-export": "node --test browser-tests/browser-video-export.test.mjs",
    "test:browser-wall": "node --test test/browser-wall-scene.test.mjs browser-tests/browser-wall-registration.test.mjs browser-tests/browser-wall-scene.test.mjs browser-tests/browser-wall-restoration.test.mjs browser-tests/browser-wall-history.test.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:coaching": "node --test browser-tests/replay-coaching.test.mjs",
    "test:template": "node --test browser-tests/replay-template.test.mjs",
    "test:preview": "node --test browser-tests/replay-preview.test.mjs",
    "test:release-browser": "node --test browser-tests/replay-actions.test.mjs browser-tests/replay-coaching.test.mjs browser-tests/replay-template.test.mjs browser-tests/photo-workflow.test.mjs browser-tests/replay-restoration.test.mjs browser-tests/replay-preview.test.mjs browser-tests/replay-paid-gate.test.mjs",
    "test:all": "npm test && npm run test:e2e",
    "test:browser-unit": "node --test test/browser-local-pose.test.mjs test/browser-wall-scene.test.mjs test/replay-head-geometry.test.mjs test/browser-accepted-pose.test.mjs test/replay-temporal-display.test.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@techstark/opencv-js": "5.0.0-release.1",
    "axios": "1.20.0",
    "element-plus": "^2.14.0",
    "mediabunny": "1.61.6",
    "onnxruntime-web": "1.30.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "vite": "^8.1.6"
  }
}
