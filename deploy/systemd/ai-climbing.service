[Unit]
Description=AI Climbing pilot backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-climbing
Group=ai-climbing
WorkingDirectory=/opt/ai-climbing/current/backend
EnvironmentFile=/etc/ai-climbing/backend.env
EnvironmentFile=-/etc/ai-climbing/release.env
ExecStart=/opt/ai-climbing/current/backend/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-climbing

[Install]
WantedBy=multi-user.target
