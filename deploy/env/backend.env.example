APP_ENV=production
LOCAL_ONLY=true
DISABLE_SUPABASE=true
ENABLE_SIMULATION=false
ENABLE_CLIMB_REPLAY=true
PILOT_AUTH_ENABLED=true
PILOT_COOKIE_SECURE=true
PILOT_USERS_FILE=/etc/ai-climbing/pilot-users.json
PILOT_AUDIT_FILE=/var/lib/ai-climbing/data/pilot_audit.jsonl

# Written separately by the release script in /etc/ai-climbing/release.env.
# RELEASE_SHA=

# Leave all three empty until an approved provider, spend cap and data terms exist.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL_NAME=
# AI 复盘：岩点使用服务器现有专项模型；姿态使用阿里云人体姿态关键点服务（上海地域）。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_REGION_ID=cn-shanghai
ALIYUN_VIAPI_ENDPOINT=facebody.cn-shanghai.aliyuncs.com
# 每秒抽取 1–10 帧，默认 4；降低可减少调用量，提高会增加成本和耗时。
CLIMB_REPLAY_POSE_FPS=4
# 默认限制为每秒 4 次云端请求，低于当前接口 5 QPS 上限。
CLIMB_REPLAY_POSE_QPS=4
# 单次成功请求的估算单价（人民币元）；仅用于任务内成本估算，实际费用以云账单为准。
CLIMB_REPLAY_POSE_UNIT_PRICE_CNY=0.0016
